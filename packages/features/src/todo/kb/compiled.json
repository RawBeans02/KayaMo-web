    {
      "id": "EVENING_REVIEW",
      "name": "Evening review",
      "writesPlan": false,
      "requiresApproval": true,
      "notes": "Map what happened; propose moves for leftovers"
    }
  ],
  "plannerRules": [
    {
      "id": "NO_SILENT_WRITE",
      "severity": "HARD",
      "appliesTo": "all",
      "statement": "Mus never writes tasks events or plans without user confirmation"
    },
    {
      "id": "NO_MOVE_FIXED",
      "severity": "HARD",
      "appliesTo": "schedule",
      "statement": "FIXED and PROTECTED blocks are not auto-moved"
    },
    {
      "id": "LEAVE_WHITESPACE",
      "severity": "HARD",
      "appliesTo": "plan",
      "statement": "Do not fill every free minute; respect daily_plans capacity"
    },
    {
      "id": "TASK_NOT_EVENT",
      "severity": "HARD",
      "appliesTo": "model",
      "statement": "A task without start/end is not an event; do not invent a clock time"
    },
    {
      "id": "ANYTIME_OFF_CLOCK",
      "severity": "HARD",
      "appliesTo": "schedule",
      "statement": "ANYTIME items stay off the timeline unless the user asks"
    },
    {
      "id": "EVENTS_FIRST",
      "severity": "HARD",
      "appliesTo": "plan",
      "statement": "Place FIXED events before fitting FLEXIBLE tasks"
    },
    {
      "id": "DEPENDENCIES",
      "severity": "HARD",
      "appliesTo": "plan",
      "statement": "Do not schedule a task before its unfinished prerequisites"
    },
    {
      "id": "OVERLOAD_NEGOTIATE",
      "severity": "HARD",
      "appliesTo": "plan",
      "statement": "If work exceeds usable open time say so and propose deferrals"
    },
    {
      "id": "PLAN_FROM_NOW",
      "severity": "HARD",
      "appliesTo": "replan",
      "statement": "Replan remaining day never rewrites completed history"
    },
    {
      "id": "NO_CALORIE_WRITE",
      "severity": "HARD",
      "appliesTo": "nutrition",
      "statement": "Planner must not change calorie floors or logged food numbers"
    },
    {
      "id": "NO_DIAGNOSIS",
      "severity": "HARD",
      "appliesTo": "copy",
      "statement": "Energy and mood flags are not medical diagnoses"
    },
    {
      "id": "NO_SHAME",
      "severity": "HARD",
      "appliesTo": "copy",
      "statement": "No cheat guilty earned or failed language; use Released for goals set down"
    },
    {
      "id": "USER_OVERRIDE",
      "severity": "HARD",
      "appliesTo": "all",
      "statement": "User edits always win over a proposal"
    },
    {
      "id": "ZOD_OUTPUT",
      "severity": "HARD",
      "appliesTo": "ai",
      "statement": "Every planner LLM call uses a Zod schema"
    },
    {
      "id": "GYM_DURATION_HISTORY",
      "severity": "SOFT",
      "appliesTo": "gym",
      "statement": "Prefer historical session length over the user's optimistic estimate"
    },
    {
      "id": "WEATHER_OUTDOOR",
      "severity": "SOFT",
      "appliesTo": "weather",
      "statement": "Rain may suggest moving outdoor items; user chooses"
    },
    {
      "id": "TRAVEL_BLOCKS",
      "severity": "SOFT",
      "appliesTo": "travel",
      "statement": "Do not abut distant locations without a travel block"
    },
    {
      "id": "FOOD_OPT_IN",
      "severity": "SOFT",
      "appliesTo": "nutrition",
      "statement": "Meal-aware suggestions only if food planning is enabled"
    }
  ],
