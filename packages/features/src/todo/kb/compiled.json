{
  "version": 1,
  "itemKinds": [
    {
      "id": "TASK",
      "name": "Task",
      "hasFixedTime": false,
      "appearsOnToday": true,
      "notes": "Work to do; due or window optional; not a clock event by default"
    },
    {
      "id": "EVENT",
      "name": "Calendar event",
      "hasFixedTime": true,
      "appearsOnToday": true,
      "notes": "Fixed start and end; tasks schedule around these"
    },
    {
      "id": "ROUTINE",
      "name": "Routine",
      "hasFixedTime": false,
      "appearsOnToday": true,
      "notes": "Repeating expected work; preferred window not a hard start"
    },
    {
      "id": "HABIT",
      "name": "Habit",
      "hasFixedTime": false,
      "appearsOnToday": true,
      "notes": "Streak-optional practice; separate from a one-off task"
    },
    {
      "id": "PROJECT",
      "name": "Project",
      "hasFixedTime": false,
      "appearsOnToday": false,
      "notes": "Container for tasks; not itself a timeline block"
    },
    {
      "id": "INBOX",
      "name": "Inbox item",
      "hasFixedTime": false,
      "appearsOnToday": false,
      "notes": "Unclassified capture; not scheduled until processed"
    },
    {
      "id": "TIME_BLOCK",
      "name": "Time block",
      "hasFixedTime": true,
      "appearsOnToday": true,
      "notes": "Planned occupancy on the day timeline (task or event snapshot)"
    },
    {
      "id": "BUSY_BLOCK",
      "name": "Busy block",
      "hasFixedTime": true,
      "appearsOnToday": true,
      "notes": "SHIPPED local-only committed hours"
    },
    {
      "id": "MEAL_BLOCK",
      "name": "Meal window",
      "hasFixedTime": false,
      "appearsOnToday": true,
      "notes": "Flexible meal window unless the meal is a fixed event"
    },
    {
      "id": "TRAVEL_BLOCK",
      "name": "Travel / transition",
      "hasFixedTime": true,
      "appearsOnToday": true,
      "notes": "Protected travel between locations"
    },
    {
      "id": "PROTECTED",
      "name": "Protected time",
      "hasFixedTime": true,
      "appearsOnToday": true,
      "notes": "Sleep family commute rest; AI must not fill"
    }
  ],
  "flexibility": [
    {
      "id": "FIXED",
      "name": "Fixed",
      "aiMaySuggestMove": false,
      "aiMayAutoMove": false,
      "notes": "Exact time; user must approve any move"
    },
    {
      "id": "FLEXIBLE",
      "name": "Flexible today",
      "aiMaySuggestMove": true,
      "aiMayAutoMove": false,
      "notes": "Should happen today; Mus suggests a slot"
    },
    {
      "id": "AUTO",
      "name": "Auto within window",
      "aiMaySuggestMove": true,
      "aiMayAutoMove": true,
      "notes": "May move inside earliest/latest after the user accepted a plan"
    },
    {
      "id": "ANYTIME",
      "name": "Anytime",
      "aiMaySuggestMove": false,
      "aiMayAutoMove": false,
      "notes": "No clock; do not force onto the timeline"
    },
    {
      "id": "PROTECTED",
      "name": "Protected",
      "aiMaySuggestMove": false,
      "aiMayAutoMove": false,
      "notes": "Never auto-fill"
    }
