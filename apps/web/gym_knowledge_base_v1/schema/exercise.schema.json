{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gym Knowledge Base Exercise Record",
  "type": "object",
  "required": [
    "record_type",
    "exercise_id",
    "canonical_name",
    "exercise_class",
    "movement_pattern_id",
    "difficulty"
  ],
  "properties": {
    "record_type": {
      "const": "exercise"
    },
    "exercise_id": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "exercise_family": {
      "type": "string"
    },
    "exercise_class": {
      "type": "string"
    },
    "training_category_id": {
      "type": "string"
    },
    "body_region": {
      "type": "string"
    },
    "primary_muscle_group": {
      "type": "string"
    },
    "movement_pattern_id": {
      "type": "string"
    },
    "movement_plane": {
      "type": "string"
    },
    "mechanic": {
      "type": "string"
    },
    "force": {
      "type": "string"
    },
    "laterality": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "tracking_mode_id": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "secondary_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_selection_allowed": {
      "type": [
        "integer",
        "boolean"
      ]
    },
    "confidence_score": {
      "type": [
        "number",
        "string"
      ]
    }
  },
  "additionalProperties": true
}