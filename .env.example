# ── @kayamo/web ────────────────────────────────────────────────────────────
# next.config.ts calls loadRootEnv(), so the repo-root .env.local normally
# supplies these. Set them here only to override the root for this app.
# Anon key only — the service-role boundary belongs to apps/admin.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin for magic-link redirects (no trailing slash).
# Local: http://localhost:3002
# Hosted: https://www.kayamo.fit  (apex kayamo.fit redirects here)
# In Supabase Auth → URL Configuration set Site URL to the same hosted
# value and add these Redirect URLs:
#   https://www.kayamo.fit/auth/callback**
#   https://www.kayamo.fit/**
#   https://kayamo.fit/auth/callback**
#   https://kayamo.fit/**
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Hosted e2e against a Vercel preview that keeps Deployment Protection on:
#   PLAYWRIGHT_BASE_URL=https://<preview>.vercel.app \
#   VERCEL_AUTOMATION_BYPASS_SECRET=<Vercel → Settings → Deployment Protection → Protection Bypass for Automation> \
#   pnpm exec playwright test
# Leave it unset for local runs. It is a secret; keep it in .env.local only.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Clerk (sign-in). Owner decision 2026-09-20: Clerk owns accounts and the
# sign-in UI; Supabase keeps its session for data, minted by /auth/bridge.
# Keys from https://dashboard.clerk.com → API keys. Both go in Vercel too.
# Without the publishable key the app builds and the demo runs, and /login
# says sign-in is not configured.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/bridge
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/bridge
# Playwright, optional: a Clerk test user (use a +clerk_test address so no
# email is ever sent). e2e/clerk-sign-in.spec.ts skips without them.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
