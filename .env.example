# ── @kayamo/web ────────────────────────────────────────────────────────────
# next.config.ts calls loadRootEnv(), so the repo-root .env.local normally
# supplies these. Set them here only to override the root for this app.
# Anon key only — the service-role boundary belongs to apps/admin.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin for magic-link redirects (no trailing slash).
# Local: http://localhost:3002
# Hosted: https://www.kayamo.fit  (apex kayamo.fit redirects here)
# In Supabase Auth → URL Configuration set Site URL to the same hosted
# value and add these Redirect URLs:
#   https://www.kayamo.fit/auth/callback**
#   https://www.kayamo.fit/**
#   https://kayamo.fit/auth/callback**
#   https://kayamo.fit/**
NEXT_PUBLIC_SITE_URL=http://localhost:3002
