{
  "name": "kayamo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "dev:pwa": "turbo run dev --filter=@kayamo/pwa",
    "dev:web": "turbo run dev --filter=@kayamo/web",
    "dev:admin": "turbo run dev --filter=@kayamo/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm check:copy && pnpm gym:kb:check && pnpm todo:kb:check",
    "test:db:integration": "pnpm --filter @kayamo/db test:integration",
    "check:copy": "tsx scripts/check-copy.ts",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @kayamo/db generate",
    "db:migrate": "pnpm --filter @kayamo/db migrate",
    "db:seed": "tsx scripts/seed.ts",
    "ph-core:build": "tsx scripts/build-ph-core.ts",
    "ph-core:check": "tsx scripts/build-ph-core.ts --check",
    "gym:kb:build": "tsx scripts/build-gym-kb.ts",
    "gym:kb:check": "tsx scripts/build-gym-kb.ts --check",
    "todo:kb:build": "tsx scripts/build-todo-kb.ts",
    "todo:kb:check": "tsx scripts/build-todo-kb.ts --check",
    "simulate:tdee": "tsx scripts/simulate-tdee.ts",
    "mobile:sync": "pnpm --filter @kayamo/mobile sync",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^3"
  }
}
